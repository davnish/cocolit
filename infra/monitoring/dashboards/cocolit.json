{
 "uid": "cocolit",
 "title": "Cocolit",
 "tags": [
  "cocolit"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Overview",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 2,
   "title": "Detections run",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(http_server_duration_milliseconds_count{cluster=\"cocolit-app\",job=\"cocolit-frontend\",http_target=\"/api/inference\"}[$__range]))",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "0"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "description": "Boxes sent to /api/inference in the selected time range"
  },
  {
   "id": 3,
   "title": "Trees found",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(cocolit_inference_detections_sum{cluster=\"cocolit-app\"}[$__range]))",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "noValue": "0"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 4,
   "title": "Errors (5xx)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(http_server_duration_milliseconds_count{cluster=\"cocolit-app\",job=\"cocolit-frontend\",http_status_code=~\"5..\"}[$__range])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 5,
   "title": "Detection time, p95",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le)(rate(http_server_duration_milliseconds_bucket{cluster=\"cocolit-app\",job=\"cocolit-frontend\",http_target=\"/api/inference\"}[$__range])))",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 8000
       },
       {
        "color": "red",
        "value": 15000
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "description": "As seen by the website, including the detector and saving to the database"
  },
  {
   "id": 6,
   "title": "Served by",
   "type": "piechart",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum by (backend)(increase(cocolit_frontend_inference_requests_total{cluster=\"cocolit-app\"}[$__range]))",
     "legendFormat": "{{backend}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "right"
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "description": "local = the node's detector, overflow = Cloud Run"
  },
  {
   "id": 7,
   "title": "Blocked or rejected (4xx)",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(http_server_duration_milliseconds_count{cluster=\"cocolit-app\",job=\"cocolit-frontend\",http_status_code=~\"4..\"}[$__range])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   },
   "description": "Mostly boxes that were too big or too small (422)"
  },
  {
   "id": 8,
   "type": "row",
   "title": "Website requests",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 9,
   "title": "Requests per minute, by route and status",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (http_target, http_status_code)(rate(http_server_duration_milliseconds_count{cluster=\"cocolit-app\",job=\"cocolit-frontend\"}[$__rate_interval])) * 60",
     "legendFormat": "{{http_target}} {{http_status_code}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 10,
   "title": "Detection time (website, end to end)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 6,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le)(rate(http_server_duration_milliseconds_bucket{cluster=\"cocolit-app\",job=\"cocolit-frontend\",http_target=\"/api/inference\"}[$__rate_interval])))",
     "legendFormat": "p50",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le)(rate(http_server_duration_milliseconds_bucket{cluster=\"cocolit-app\",job=\"cocolit-frontend\",http_target=\"/api/inference\"}[$__rate_interval])))",
     "legendFormat": "p95",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 11,
   "type": "row",
   "title": "Detector",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 12,
   "title": "Time per stage, p95",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 15,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, stage)(rate(cocolit_inference_stage_duration_seconds_bucket{cluster=\"cocolit-app\"}[$__rate_interval])))",
     "legendFormat": "{{stage}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "validate, detect (tile download + model), postprocess"
  },
  {
   "id": 13,
   "title": "Trees per detection (average)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 15,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum(rate(cocolit_inference_detections_sum{cluster=\"cocolit-app\"}[$__rate_interval])) / sum(rate(cocolit_inference_detections_count{cluster=\"cocolit-app\"}[$__rate_interval]))",
     "legendFormat": "trees",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 14,
   "title": "Detection confidence",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 15,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le)(rate(cocolit_inference_detection_confidence_bucket{cluster=\"cocolit-app\"}[$__rate_interval])))",
     "legendFormat": "median",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "histogram_quantile(0.1, sum by (le)(rate(cocolit_inference_detection_confidence_bucket{cluster=\"cocolit-app\"}[$__rate_interval])))",
     "legendFormat": "10th percentile",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "description": "A lasting drop can mean the imagery or the model has drifted"
  },
  {
   "id": 15,
   "type": "row",
   "title": "App server",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 16,
   "title": "Memory by pod, against its limit",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (pod)(container_memory_working_set_bytes{cluster=\"cocolit-app\",namespace=\"apps\",container!=\"\"})",
     "legendFormat": "{{pod}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "expr": "sum by (pod)(kube_pod_container_resource_limits{cluster=\"cocolit-app\",namespace=\"apps\",resource=\"memory\"})",
     "legendFormat": "limit {{pod}}",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 17,
   "title": "CPU by pod (cores)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "expr": "sum by (pod)(rate(container_cpu_usage_seconds_total{cluster=\"cocolit-app\",namespace=\"apps\",container!=\"\"}[$__rate_interval]))",
     "legendFormat": "{{pod}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 18,
   "title": "Node memory used",
   "type": "gauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 24,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "1 - node_memory_MemAvailable_bytes{cluster=\"cocolit-app\"} / node_memory_MemTotal_bytes{cluster=\"cocolit-app\"}",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 19,
   "title": "Node disk used",
   "type": "gauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 21,
    "y": 24,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "1 - node_filesystem_avail_bytes{cluster=\"cocolit-app\",mountpoint=\"/\"} / node_filesystem_size_bytes{cluster=\"cocolit-app\",mountpoint=\"/\"}",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.75
       },
       {
        "color": "red",
        "value": 0.85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 20,
   "title": "Node CPU used",
   "type": "gauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 28,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "1 - avg(rate(node_cpu_seconds_total{cluster=\"cocolit-app\",mode=\"idle\"}[5m]))",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.8
       },
       {
        "color": "red",
        "value": 0.95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 21,
   "title": "Pod restarts",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 21,
    "y": 28,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "sum(increase(kube_pod_container_status_restarts_total{cluster=\"cocolit-app\",namespace=\"apps\"}[$__range])) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 22,
   "type": "row",
   "title": "Traces and logs",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 1
   }
  },
  {
   "id": 23,
   "title": "Recent detections (click a trace to see where the time went)",
   "type": "table",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 33,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "queryType": "traceql",
     "query": "{resource.service.name=\"cocolit-frontend\" && name=\"POST /api/inference\"}",
     "limit": 20,
     "tableType": "traces",
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 24,
   "title": "App logs",
   "type": "logs",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 12,
    "y": 33,
    "w": 12,
    "h": 10
   },
   "targets": [
    {
     "expr": "{cluster=\"cocolit-app\", namespace=\"apps\", container!=\"cloudflared\"}",
     "queryType": "range",
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   }
  }
 ],
 "links": [
  {
   "title": "Live site",
   "url": "https://cocolit.prithvilabs.com",
   "type": "link",
   "targetBlank": true
  }
 ]
}
