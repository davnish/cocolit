# Copy to .env for local runs (both apps load it with python-dotenv).

# Frontend -> inference
INFERENCE_URL=http://127.0.0.1:8000/predict
# INFERENCE_OVERFLOW_URL=https://<cloud-run-service>/predict
# INFERENCE_API_KEY=change-me
# INFERENCE_MAX_LOCAL=1

# Database (PostGIS); leave unset to run without saving or statistics
# POSTGRES_HOST=localhost
# POSTGRES_DATABASE=cocolitdb
# POSTGRES_USERNAME=cocolit_user
# POSTGRES_PASSWORD=change-me

# Error emails (optional)
# SMTP_FROMADDR=
# SMTP_TOADDRS=
# SMTP_USERNAME=
# SMTP_PASSWORD=
